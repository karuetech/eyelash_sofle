#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    homerow: homerow {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <300>;
        flavor = "tap-preferred";
        require-prior-idle-ms = <25>;
    };

    kphomerow: kphomerow {
        compatible = "zmk,behavior-hold-tap";
        label = "KPHOMEROW";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <4000>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <34 35>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <34 35 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC         &kp N1    &kp N2        &kp N3              &kp N4                   &kp N5       &mmv MOVE_UP     &kp N6     &kp N7                    &kp N8                      &kp N9     &kp N0    &kp BACKSPACE
&kp TAB         &kp Q     &kp W         &kp E               &kp R                    &kp T        &mmv MOVE_DOWN   &kp Y      &kp U                     &kp I                       &kp O      &kp P     &kp BSLH
&kp LEFT_SHIFT  &kp A     &kp S         &kphomerow LCTRL D  &kphomerow LEFT_SHIFT F  &kp G        &mmv MOVE_LEFT   &kp H      &kphomerow RIGHT_SHIFT J  &kphomerow RIGHT_CONTROL K  &kp L      &kp SEMI  &kp APOS
&kp LCTRL       &kp Z     &kp X         &kp C               &kp V                    &kp B        &mmv MOVE_RIGHT  &kp N      &kp M                     &kp COMMA                   &kp DOT    &kp FSLH  &kp RSHFT
&kp C_MUTE      &kp CAPS  &kp LEFT_ALT  &kp LEFT_GUI        &homerow 1 TAB           &kp SPACE    &mkp LCLK        &kp ENTER  &kp BACKSPACE             &kp MINUS                   &kp RCTRL  &to 4
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1       &kp F2          &kp F3        &kp F4           &kp F5                  &kp UP_ARROW     &kp F6                 &kp F7        &kp F8        &kp F9        &kp F10           &trans
&trans      &kp F11      &kp F12         &kp UP_ARROW  &trans           &kp LEFT_BRACE          &kp DOWN_ARROW   &kp RIGHT_BRACE        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS         &kp EQUAL
&trans      &trans       &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp LEFT_PARENTHESIS    &kp LEFT_ARROW   &kp RIGHT_PARENTHESIS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &sys_reset   &kp C_MUTE      &kp C_VOL_DN  &kp C_VOLUME_UP  &kp LEFT_BRACKET        &kp RIGHT_ARROW  &kp RIGHT_BRACKET      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_NUMLOCK    &kp DELETE
&kp C_MUTE  &bootloader  &trans          &trans        &trans           &trans                  &mkp RCLK        &trans                 &kp KP_PLUS   &kp NUMBER_0  &kp KP_DOT    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER1";
        };

        layer_2 {
            bindings = <
&kp TILDE  &trans  &trans          &trans          &trans           &trans    &msc SCRL_UP     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &trans
&trans     &trans  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans    &msc SCRL_DOWN   &kp PG_UP  &kp HOME   &kp UP     &kp END    &kp UNDER  &kp PLUS
&trans     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &msc SCRL_LEFT   &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LBRC   &kp RBRC
&trans     &trans  &trans          &trans          &trans           &trans    &msc SCRL_RIGHT  &trans     &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans     &kp DELETE
&trans     &trans  &trans          &trans          &trans           &trans    &mkp LCLK        &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "LAYER2";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans           &trans           &trans           &trans           &trans           &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans         &trans        &trans          &trans  &rgb_ug RGB_OFF  &trans           &kp INSERT       &trans           &kp PRINTSCREEN  &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans         &trans        &trans          &trans  &rgb_ug RGB_ON   &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
&trans  &trans        &trans          &kp C_AL_CALC  &trans        &trans          &trans  &trans           &trans           &sys_reset       &soft_off        &bootloader      &trans
&trans  &trans        &trans          &trans         &trans        &trans          &trans  &trans           &trans           &trans           &trans           &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_4 {
            bindings = <
&kp ESCAPE        &kp N5        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4    &trans  &kp F1     &kp F2  &kp F3  &kp F4  &kp F6  &trans
&kp TAB           &kp NUMBER_6  &kp Q         &kp W         &kp E           &kp R           &trans  &trans     &trans  &trans  &trans  &trans  &trans
&kp B             &kp N7        &kp A         &kp S         &kp D           &kp F           &trans  &trans     &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &trans        &kp Z         &kp X         &kp C           &kp V           &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans            &trans        &kp M         &kp G         &kp LEFT_SHIFT  &kp SPACE       &trans  &kp ENTER  &trans  &trans  &trans  &to 0
            >;

            display-name = "LAYER4";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
